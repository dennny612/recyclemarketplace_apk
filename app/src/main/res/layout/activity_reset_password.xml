<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Judul -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset Password"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginTop="30dp"/>

        <!-- Deskripsi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Silakan isi data di bawah untuk mengganti password"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginTop="8dp"/>

        <!-- EMAIL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginTop="24dp"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Masukkan email"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:background="@drawable/edittext_bg"
            android:padding="12dp"
            android:layout_marginTop="8dp"/>

        <!-- PASSWORD LAMA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password Lama"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/etOldPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Masukkan password lama"
            android:inputType="textPassword"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:background="@drawable/edittext_bg"
            android:padding="12dp"
            android:layout_marginTop="8dp"/>

        <!-- PASSWORD BARU -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password Baru"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Masukkan password baru"
            android:inputType="textPassword"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:background="@drawable/edittext_bg"
            android:padding="12dp"
            android:layout_marginTop="8dp"/>

        <!-- KONFIRMASI PASSWORD -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Konfirmasi Password Baru"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Ulangi password baru"
            android:inputType="textPassword"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:background="@drawable/edittext_bg"
            android:padding="12dp"
            android:layout_marginTop="8dp"/>

        <!-- BUTTON -->
        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Simpan Password Baru"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:layout_marginTop="24dp"/>

    </LinearLayout>

</ScrollView>